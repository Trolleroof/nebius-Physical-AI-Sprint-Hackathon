# Copy to hardware/so101.env and fill in after Step 2–3 of Guide 1.
#   cp hardware/so101.env.example hardware/so101.env
#
# Re-check ports at the start of each session — USB hubs renumber them.

export LEADER=/dev/tty.usbmodemAAAAAAAA
export FOLLOWER=/dev/tty.usbmodemBBBBBBBB

# Must match the --id flags used during lerobot-calibrate
export LEADER_ID=my_leader_arm
export FOLLOWER_ID=my_follower_arm
